---
interface Props {
  reportes: Array<{
    _id?: string;
    email: string;
    fecha: string | Date;
    mayorConsumo: string;
    packageName1: string;
    tiempoUso1: number;
    packageName2: string;
    tiempoUso2: number;
    packageName3: string;
    tiempoUso3: number;
    packageName4: string;
    tiempoUso4: number;
    packageName5: string;
    tiempoUso5: number;
  }>;
  currentSort?: string;
  currentOrder?: 'asc' | 'desc';
}

const { reportes, currentSort, currentOrder } = Astro.props;

const formatDate = (date: string | Date): string => {
  const d = new Date(date);
  return d.toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
};

const formatTime = (minutes: number): string => {
  if (minutes < 60) {
    return `${minutes} min`;
  }
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return mins > 0 ? `${hours}h ${mins}min` : `${hours}h`;
};

const getSortIndicator = (field: string): string => {
  if (currentSort === field) {
    return currentOrder === 'asc' ? ' ↑' : ' ↓';
  }
  return '';
};
---

<div class="table-container">
  <table id="reportes-table" role="table" aria-label="Tabla de reportes">
    <thead>
      <tr>
        <th>
          <button type="button" class="sort-btn" data-sort="email">
            Email <span class="sort-indicator">{getSortIndicator('email')}</span>
          </button>
        </th>
        <th>
          <button type="button" class="sort-btn" data-sort="fecha">
            Fecha <span class="sort-indicator">{getSortIndicator('fecha')}</span>
          </button>
        </th>
        <th>
          <button type="button" class="sort-btn" data-sort="mayorConsumo">
            Mayor Consumo <span class="sort-indicator">{getSortIndicator('mayorConsumo')}</span>
          </button>
        </th>
        <th>Paquete 1</th>
        <th>Tiempo 1</th>
        <th>Paquete 2</th>
        <th>Tiempo 2</th>
        <th>Paquete 3</th>
        <th>Tiempo 3</th>
        <th>Paquete 4</th>
        <th>Tiempo 4</th>
        <th>Paquete 5</th>
        <th>Tiempo 5</th>
      </tr>
    </thead>
    <tbody id="reportes-tbody">
      {reportes.length === 0 ? (
        <tr>
          <td colspan="13" style="text-align: center; padding: 2rem;">
            No se encontraron reportes
          </td>
        </tr>
      ) : (
        reportes.map((reporte) => (
          <tr>
            <td data-label="Email">{reporte.email}</td>
            <td data-label="Fecha">{formatDate(reporte.fecha)}</td>
            <td data-label="Mayor Consumo">{reporte.mayorConsumo}</td>
            <td data-label="Paquete 1">{reporte.packageName1}</td>
            <td data-label="Tiempo 1">{formatTime(reporte.tiempoUso1)}</td>
            <td data-label="Paquete 2">{reporte.packageName2}</td>
            <td data-label="Tiempo 2">{formatTime(reporte.tiempoUso2)}</td>
            <td data-label="Paquete 3">{reporte.packageName3}</td>
            <td data-label="Tiempo 3">{formatTime(reporte.tiempoUso3)}</td>
            <td data-label="Paquete 4">{reporte.packageName4}</td>
            <td data-label="Tiempo 4">{formatTime(reporte.tiempoUso4)}</td>
            <td data-label="Paquete 5">{reporte.packageName5}</td>
            <td data-label="Tiempo 5">{formatTime(reporte.tiempoUso5)}</td>
          </tr>
        ))
      )}
    </tbody>
  </table>
</div>

<style>
  .table-container {
    overflow-x: auto;
    margin-bottom: 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    box-shadow: 0 1px 3px rgba(34, 34, 34, 0.05);
    width: 100%;
  }

  table {
    width: 100%;
    min-width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background-color: var(--color-bg);
  }

  thead {
    background: linear-gradient(to bottom, 
      var(--color-bg-secondary) 0%, 
      rgba(0, 0, 0, 0.02) 100%);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  thead tr {
    border-bottom: 2px solid var(--color-border);
  }

  th {
    padding: 1rem 0.75rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text);
    white-space: nowrap;
    position: relative;
  }

  .sort-btn {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    width: 100%;
    text-align: left;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.2s ease;
  }

  .sort-btn:hover {
    color: var(--color-primary);
  }

  .sort-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
    border-radius: 4px;
  }

  .sort-indicator {
    font-size: 0.75rem;
    color: var(--color-primary);
    font-weight: 700;
    margin-left: 0.25rem;
  }

  tbody {
    background-color: var(--color-bg);
  }

  tbody tr {
    border-bottom: 1px solid var(--color-border);
    transition: all 0.15s ease;
    background-color: var(--color-bg);
  }

  tbody tr:nth-child(even) {
    background-color: rgba(0, 0, 0, 0.015);
  }

  @media (prefers-color-scheme: dark) {
    tbody tr:nth-child(even) {
      background-color: rgba(255, 255, 255, 0.02);
    }
  }

  tbody tr:hover {
    background-color: rgba(0, 102, 204, 0.08) !important;
  }

  @media (prefers-color-scheme: dark) {
    tbody tr:hover {
      background-color: rgba(74, 158, 255, 0.12) !important;
    }
  }

  td {
    padding: 0.875rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.6;
    vertical-align: middle;
  }

  tbody tr td[colspan] {
    text-align: center;
    padding: 3rem 2rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Responsive design for mobile */
  @media (max-width: 768px) {
    .table-container {
      border-radius: var(--radius-sm);
      border-left: none;
      border-right: none;
      margin-left: calc(-1 * var(--spacing-lg));
      margin-right: calc(-1 * var(--spacing-lg));
      width: calc(100% + 2 * var(--spacing-lg));
    }

    table {
      font-size: 0.8125rem;
    }

    thead {
      display: none;
    }

    tbody tr {
      display: block;
      margin-bottom: 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 0.75rem;
      background-color: var(--color-bg-secondary);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    tbody tr:nth-child(even) {
      background-color: var(--color-bg-secondary);
    }

    td {
      display: block;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--color-border);
      text-align: left;
      position: relative;
      padding-left: 40%;
    }

    td:last-child {
      border-bottom: none;
    }

    td::before {
      content: attr(data-label);
      position: absolute;
      left: 0;
      width: 35%;
      padding-right: 1rem;
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-text-muted);
    }

    td[colspan] {
      text-align: center;
      padding: 2rem 1rem;
      border-bottom: none;
    }

    td[colspan]::before {
      display: none;
    }
  }
</style>

